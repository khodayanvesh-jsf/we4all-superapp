{
  "headers": [
    {
      "source": "/ota-manifest.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html?admin=true" },
    { "source": "/((?!api/|ota-manifest\\.json|WE4ALL.*\\.apk).*)", "destination": "/index.html" }
  ]
}